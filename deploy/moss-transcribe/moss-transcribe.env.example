# Copy to deploy/moss-transcribe/moss-transcribe.env (gitignored) and adjust.
#
# No token is required: OpenMOSS-Team/MOSS-Transcribe-Diarize is Apache-2.0
# and ungated, unlike the pyannote community-1 weights this platform gates
# behind HUGGINGFACE_TOKEN. The weights are only ~2GB, so an unauthenticated
# pull is not painful either; set HF_TOKEN if the Hub rate-limits you. Note
# this is the container's own env file: it does not read the repo-root .env,
# so the token has to be repeated here.
# HF_TOKEN=hf_...

# Host port (change if 9024 is taken). Must match MOSS_TRANSCRIBE_URL in the
# repo-root .env and the health_url in
# apps/background_worker/supervisor/registry.py.
MOSS_TRANSCRIBE_PORT=9024

# The 0.9B open-source checkpoint. MOSS-Transcribe-Diarize Pro is a stronger
# model but is API-access-only, not a downloadable checkpoint, so it cannot be
# served here.
MOSS_TRANSCRIBE_MODEL_ID=OpenMOSS-Team/MOSS-Transcribe-Diarize

# Free-memory admission gate ONLY -- not the KV cache size (that is the setting
# below). vLLM refuses to start unless `free_memory >= total * util`, and this
# check runs even when --kv-cache-memory-bytes is set, despite vLLM's docstring
# implying otherwise. Kept as low as the real footprint allows so MOSS can still
# start on a busy GPU: 0.20 asserts ~24GiB free, covering ~2GiB of weights plus
# the 16GiB reserved below plus activations. Do NOT remove it to "let
# kv-cache-memory-bytes handle it" -- the flag then defaults to 0.92, demands
# ~110GiB free, and the container crash-loops (17 restarts before this was
# caught).
MOSS_TRANSCRIBE_GPU_MEM_UTIL=0.20

# Bytes of KV cache to reserve, passed straight to vLLM's
# --kv-cache-memory-bytes. This is an ABSOLUTE size and is what actually governs
# the cache; the utilization fraction above only gates startup.
#
# Why not size the cache with the utilization fraction, the way vibevoice does: the
# fraction path computes the cache as `total * util - non_kv_cache_memory`,
# and non_kv_cache_memory comes from a profile run that measures free memory
# before and after. Anything ELSE allocating on the GPU during that window --
# the in-process pyannote/sherpa models, or a co-resident container -- lands in
# that delta and shrinks MOSS's cache. At util=0.10 (a ~12GiB budget) there was
# so little slack that this went negative and the engine aborted at startup with
# "No available memory for the cache blocks". That is not hypothetical: it
# happened twice on a real 5-model run, while MOSS alone had been fine.
# Reserving bytes directly skips the profiling, so the number below is what MOSS
# gets regardless of what else is resident.
#
# Sized from this model's own geometry, cross-checked against a live run:
#   28 layers x 8 kv_heads x 128 head_dim x 2 (K+V) x 2 bytes = 114,688 B/token.
# (Confirmed exactly: an 8GiB reservation reported 74,896 tokens.)
# A full MOSS_TRANSCRIBE_MAX_MODEL_LEN (131,072) request therefore needs 14.0GiB;
# 16GiB covers it with the same ~1.14x margin. The platform serializes one job
# per model (see CLAUDE.md), so two concurrent full-length requests never happen.
# Total MOSS footprint is then ~20GiB (2GiB weights + this + activations) of the
# ~120GiB unified pool, leaving room for whatever co-resides -- which is why this
# model does not need vibevoice's requires_exclusive_gpu.
# If you change MOSS_TRANSCRIBE_MAX_MODEL_LEN, rescale this: bytes ~= len * 114688.
MOSS_TRANSCRIBE_KV_CACHE_BYTES=17179869184

# The platform serializes one job per model (see CLAUDE.md), so there is never
# real concurrent load; this just allows a stray manual/smoke request without
# preempting an in-flight job.
MOSS_TRANSCRIBE_MAX_NUM_SEQS=2

# The model's real context window: config.json carries
# text.max_position_embeddings=131072, which is the README's "128k long-context
# transcription". The audio itself eats most of it -- the Whisper frontend at
# 16kHz with a 4x temporal merge costs 12.5 tokens per second of audio:
#   32 min ->  24,284 tokens (measured)   90 min -> 67,500   2h -> 90,000
# so a 90-minute file (MOSS's documented ceiling) needs ~67.5k for audio alone
# and only then has room to emit a transcript. An earlier pass copied
# vibevoice's 65536 here, which silently capped MOSS at ~87 minutes of audio
# with a zero-token output budget. Lowering this also shrinks
# MOSS_TRANSCRIBE_KV_CACHE_BYTES's requirement -- see that setting.
MOSS_TRANSCRIBE_MAX_MODEL_LEN=131072

# The multimodal ENCODER CACHE, despite the name: vLLM sets
# `encoder_cache_size = max_num_batched_tokens` and an audio item cannot be
# split across batches, so this must hold a whole file's embeddings at once. The
# vLLM default is 2048, which rejects anything past ~2.7 minutes of audio with
# "audio item with N embedding tokens ... exceeds the pre-allocated encoder cache
# size 2048". (That error advises --limit-mm-per-prompt; ignore it, that caps the
# number of items, not their size.) 98304 covers the 2-hour file this platform
# accepts (90,000 tokens); the cache itself is cheap, ~98304 x 1024 x 2 = ~200MB.
MOSS_TRANSCRIBE_MAX_BATCHED_TOKENS=98304
