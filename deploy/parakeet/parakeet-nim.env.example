# Copy to deploy/parakeet/parakeet-nim.env (gitignored) and fill in your key.
# Get one at https://org.ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# Streaming profile (DGX Spark / GB10). See docs/reports/parakeet-nim-deployment.md
# and docs/reports/websocket-grpc-bridge.md ("A/B tuning console").
# str     = streaming low-latency
# str-thr = streaming throughput
# ofl     = offline batch only
# all     = all modes preloaded at once (~50 GB GPU; OK on Spark's 128 GB
#           unified memory) -- default, so mode can be A/B'd from the UI
#           without a container restart; only type/diarizer/vad changes
#           still require one. This is also managed by the A/B console
#           (runtime/nim_control.py rewrites this line); editing it by hand
#           only matters before the first boot or if the console is unused.
PARAKEET_NIM_TAGS_SELECTOR=diarizer=sortformer,mode=str,type=default,vad=silero

# Host ports (change if 9000/50051 are taken; must match NIM_STR_HEALTH_PORT /
# NIM_OFL_HEALTH_PORT in .env at repo root)
PARAKEET_NIM_HTTP_PORT=9030
PARAKEET_NIM_GRPC_PORT=50051

# Offline batch container (parakeet-nim-ofl)
PARAKEET_NIM_OFL_TAGS_SELECTOR=diarizer=sortformer,mode=ofl,type=default,vad=silero
PARAKEET_NIM_OFL_HTTP_PORT=9031
PARAKEET_NIM_OFL_GRPC_PORT=50052
