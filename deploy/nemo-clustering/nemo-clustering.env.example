# Copy to deploy/nemo-clustering/nemo-clustering.env (gitignored) and adjust.

# Only needed if your NGC org gates nvcr.io/nvidia/nemo; leave blank to try
# an anonymous pull first. Get one at https://org.ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# Host port (change if 9020 is taken)
NEMO_CLUSTERING_PORT=9020

# Max speakers the spectral clustering module will consider for one
# recording (meetings up to ~15-20 speakers -- raise further if needed).
NEMO_CLUSTERING_MAX_SPEAKERS=20
