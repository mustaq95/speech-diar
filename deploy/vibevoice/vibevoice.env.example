# Copy to deploy/vibevoice/vibevoice.env (gitignored) and adjust.
#
# No token is *required*: microsoft/VibeVoice-ASR is MIT-licensed and
# ungated, unlike the pyannote community-1 weights this platform gates behind
# HUGGINGFACE_TOKEN. But the weights are ~16GB across 8 shards, and an
# unauthenticated pull is rate-limited by the Hub -- set HF_TOKEN below to
# speed up the first startup. Note this is the container's own env file; it
# does not read the repo-root .env, so the token has to be repeated here.
# HF_TOKEN=hf_...

# Host port (change if 9023 is taken)
VIBEVOICE_PORT=9023

# The research-codebase checkpoint format that the vLLM plugin expects. Do
# not point this at microsoft/VibeVoice-ASR-HF: that one carries the
# transformers-native VibeVoiceAsrForConditionalGeneration architecture (what
# the old plain-transformers container used), not the format the vLLM plugin
# loads.
VIBEVOICE_MODEL_ID=microsoft/VibeVoice-ASR

# Fraction of the GPU's (unified, on GB10/DGX Spark ~120GiB) memory vLLM may
# reserve for weights + activations + KV cache. Upstream's default (0.8)
# assumes a GPU dedicated to this one model; here the supervisor keeps up to
# MAX_RESIDENT_MODELS resident at once, so this is sized to coexist with one
# other model. The weights alone take ~18.2GiB, so at 0.35 (~42GiB budget)
# vLLM reports ~14.6GiB / ~272k tokens of KV cache -- ample for 2 sequences
# of the 65536 max-model-len. Do NOT drop this near 0.15: 0.35*120-18.2 still
# leaves headroom, but 0.15*120 is under the weight size and vLLM aborts at
# start with "No available memory for the cache blocks". (An earlier note
# here blamed 0.35 for a weight-load SIGKILL; that was the GPU supervisor
# idle-unloading a manually-started container via `docker stop`, not a
# memory fault -- unrelated to this value.)
VIBEVOICE_GPU_MEM_UTIL=0.35

# The platform serializes one job per model (see CLAUDE.md), so there is
# never real concurrent load; this just allows a stray manual/smoke request
# without preempting an in-flight job.
VIBEVOICE_MAX_NUM_SEQS=2

# Upstream's default, sized for up to ~60 minutes of audio plus the model's
# own output budget.
VIBEVOICE_MAX_MODEL_LEN=65536
