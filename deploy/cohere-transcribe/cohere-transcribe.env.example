# Copy to deploy/cohere-transcribe/cohere-transcribe.env (gitignored) and adjust.
#
# HF_TOKEN is REQUIRED here, unlike moss-transcribe: the
# CohereLabs/cohere-transcribe-arabic-07-2026 repo is GATED, so an
# unauthenticated pull fails outright rather than merely being rate-limited.
# Accept the model's conditions on its Hugging Face page first, then paste a
# token with read access. Note this is the container's own env file: it does
# not read the repo-root .env, so the token has to be repeated here (the same
# arrangement deploy/vibevoice/vibevoice.env uses).
HF_TOKEN=hf_...

# Host port (change if 9025 is taken). Must match COHERE_TRANSCRIBE_URL in the
# repo-root .env.
COHERE_TRANSCRIBE_PORT=9025

# The 2B Arabic/English speech-to-text checkpoint. Apache-2.0.
COHERE_TRANSCRIBE_MODEL_ID=CohereLabs/cohere-transcribe-arabic-07-2026

# Free-memory admission gate ONLY -- not the KV cache size (that is the setting
# below). vLLM refuses to start unless `free_memory >= total * util`, and this
# check runs even when --kv-cache-memory-bytes is set, despite vLLM's docstring
# implying otherwise. 0.15 asserts ~18GiB free on this 120GiB device, covering
# ~4GiB of bf16 weights plus the reservation below plus activations.
#
# This matters more here than for the diarization containers: this one is
# EXEMPT from the GPU residency cap (MAX_RESIDENT_MODELS), so it is expected to
# start while diarization models are already resident. Do NOT remove this flag
# to "let kv-cache-memory-bytes handle it" -- it then defaults to 0.92, demands
# ~110GiB free, and the container crash-loops.
COHERE_TRANSCRIBE_GPU_MEM_UTIL=0.15

# Bytes of KV cache to reserve, passed straight to vLLM's
# --kv-cache-memory-bytes. This is an ABSOLUTE size and is what actually
# governs the cache; the utilization fraction above only gates startup.
#
# Why not size the cache with the utilization fraction (see
# moss-transcribe.env.example for the long version): the fraction path computes
# the cache as `total * util - non_kv_cache_memory`, and non_kv_cache_memory
# comes from a profile run that measures free memory before and after. Anything
# else allocating on the GPU during that window -- the in-process
# pyannote/sherpa models, the ctc aligner, or a co-resident container -- lands
# in that delta and shrinks this cache. On a real multi-model run that went
# negative and aborted the engine with "No available memory for the cache
# blocks". Reserving bytes directly skips the profiling.
#
# 4GiB is generous for this model: an ASR request's context is one audio window
# plus its transcript, not a long chat history, and the platform never issues
# two concurrent transcript jobs. Raise only if vLLM reports it cannot fit a
# request's KV.
COHERE_TRANSCRIBE_KV_CACHE_BYTES=4294967296

# The multimodal ENCODER CACHE, despite the name: vLLM sets
# `encoder_cache_size = max_num_batched_tokens`, and a single audio item cannot
# be split across batches -- so this must hold one item's embeddings at once.
# The vLLM default of 2048 rejects long inputs with "audio item with N
# embedding tokens ... exceeds the pre-allocated encoder cache size 2048".
# (That error advises --limit-mm-per-prompt; ignore it, that caps the NUMBER of
# items, not their size.)
#
# How large this needs to be depends on whether vLLM feeds this model a whole
# file as one item or lets the model's own feature extractor chunk it -- the
# model card documents chunking with reassembly via `audio_chunk_index`, but
# MOSS's vLLM integration disables chunking entirely, so it varies per model.
# 32768 covers a long input either way and costs ~67MB. If a long file is
# rejected with the encoder-cache error, raise this to moss-transcribe's 98304
# (which covers a full 2-hour file at 12.5 tokens/sec).
COHERE_TRANSCRIBE_MAX_BATCHED_TOKENS=32768

# The platform serializes transcript jobs, so there is never real concurrent
# load; this just allows a stray manual/smoke request without preempting an
# in-flight job.
COHERE_TRANSCRIBE_MAX_NUM_SEQS=2
