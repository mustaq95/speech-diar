# Copy to .env and adjust. Every runtime setting lives here and is read
# ONLY through packages/config/settings.py — moving between dev, staging,
# production, or DGX Spark means editing this file, not the code.

# --- Database (Postgres) ---
DATABASE_URL=postgresql+psycopg://postgres:pg123456@localhost:5432/diarization

# --- Queue (Redis / RQ) ---
REDIS_URL=redis://localhost:6379/0
# Number of worker processes ./scripts/run_workers.sh starts, so that many
# models can run at the same time instead of queueing behind one another
# (DGX: raise this further).
WORKER_CONCURRENCY=3
# Ceiling on how long a single model's job may run before RQ kills it. Must
# stay >= the largest per-model timeout below (AZURE_BATCH_JOB_TIMEOUT_SEC /
# NEMO_CLUSTERING_TIMEOUT_SEC at 1800s) or those never get a chance to
# fire -- AND, since the GPU supervisor (see below) can make a job wait out
# a container cold-start before its own inference timeout starts counting,
# it must stay >= the largest (cold-start + inference) SUM across managed
# models. Worst case today: vibevoice's 600s cold-start + 5400s inference
# = 6000s floor, padded here for margin.
QUEUE_JOB_TIMEOUT_SEC=6600

# --- Primary storage lane: MinIO / S3 (used by local diarization models) ---
# Matches docker-compose.yml defaults locally; point at real S3/managed
# storage in production by changing these three.
# Port 9010, not 9000: on DGX Spark hosts running the Parakeet NIM containers,
# host port 9000 is owned by parakeet-nim-str's HTTP API (see NIM_* below).
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=diarization-audio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- External recording API (S3-backed meeting-recording source) ---
# Bearer token for pulling audio via "Load Blob". Fallback used when the pasted
# input carries no token; a token pasted as a curl -H line wins. The local
# replica (tools/recording_api on :8215) enforces this same value, so seeding
# and ingestion match. Switching to production ADEO = change this + paste ADEO
# URLs, no code change.
RECORDING_API_TOKEN=dev-recording-token
RECORDING_FETCH_TIMEOUT_SEC=600

# --- Azure Speech (real-time + batch diarization) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Optional custom endpoint (AI Foundry); batch uses this when set, else
# https://<AZURE_SPEECH_REGION>.api.cognitive.microsoft.com
AZURE_SPEECH_ENDPOINT=
# Default recognition locale for both the real-time and batch engines.
LOCALE=en-US
AZURE_REALTIME_TRANSCRIBE_TIMEOUT_SEC=1800
AZURE_BATCH_POLL_INTERVAL_SEC=10
AZURE_BATCH_JOB_TIMEOUT_SEC=1800
AZURE_BATCH_TIME_TO_LIVE=PT4H
AZURE_BATCH_MAX_SPEAKERS=8

# --- Azure lane storage: Blob (ONLY touched when the Azure model is toggled
# on; audio for that lane never touches MinIO) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=diarization-audio
AZURE_STORAGE_SAS_READ_EXPIRY_HOURS=48

# --- API ---
API_PORT=8010
# Comma-separated list of origins allowed to call the API (the Vite dev
# server by default).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend runtime config (served via GET /config; changing this needs
# no frontend rebuild) ---
FRONTEND_POLL_INTERVAL_MS=1500

# --- Local diarization models ---
# cpu on a dev machine; cuda on DGX Spark or any CUDA-equipped worker host.
DIARIZATION_DEVICE=cpu
# HuggingFace access token, required to download the gated pyannote community-1
# pipeline, plus speaker-diarization-3.1 and its segmentation-3.0 dependency
# (used by the wespeaker-resnet34 model). Accept the model conditions at
# https://huggingface.co/pyannote/speaker-diarization-community-1,
# https://huggingface.co/pyannote/speaker-diarization-3.1, and
# https://huggingface.co/pyannote/segmentation-3.0 first.
HUGGINGFACE_TOKEN=
# Directory for sherpa-onnx's segmentation.onnx and embedding.onnx model
# files; downloaded here on first use if missing (ungated, no token needed).
SHERPA_MODEL_DIR=~/.cache/sherpa-onnx-diarization

# --- NVIDIA Parakeet-Sortformer NIM (DGX Spark local Triton/Riva containers) ---
# Started separately via ./deploy/parakeet_nim_up.sh (docker-compose.parakeet-nim.yml).
# gRPC endpoints, not the HTTP ones -- diarization speaker tags are only
# exposed on the Riva gRPC API, not the plain /v1/audio/transcriptions route.
NIM_STR_GRPC=localhost:50051
NIM_OFL_GRPC=localhost:50052
# HTTP health-check ports only -- must match deploy/parakeet/parakeet-nim.env's
# PARAKEET_NIM_HTTP_PORT / PARAKEET_NIM_OFL_HTTP_PORT. Change both together if
# 9000/9001 collide with something else already running on the host.
NIM_STR_HEALTH_PORT=9030
NIM_OFL_HEALTH_PORT=9031
NIM_LANGUAGE=multi
NIM_MAX_SPEAKERS=8
NIM_GRPC_TIMEOUT_SEC=1800
# Separate from NIM_GRPC_TIMEOUT_SEC (bounds one ASR call): the GPU
# supervisor's cold-start budget while waiting for /v1/health/ready after a
# `docker start`.
NIM_COLD_START_TIMEOUT_SEC=1800

# --- NeMo Clustering Diarizer (custom container; no turnkey NIM ships this) ---
# Started separately via ./deploy/nemo-clustering/nemo_clustering_up.sh
# (docker-compose.nemo-clustering.yml). Cascaded MarbleNet VAD + TitaNet +
# spectral clustering, for meetings with more speakers than the Sortformer
# NIMs above are tuned for.
NEMO_CLUSTERING_URL=http://localhost:9020
NEMO_CLUSTERING_TIMEOUT_SEC=1800

# --- 3D-Speaker CAM++ Clustering Diarizer (custom container; no turnkey NIM ships this) ---
# Started separately via
# ./deploy/3d-speaker-clustering/3d_speaker_clustering_up.sh
# (docker-compose.3d-speaker-clustering.yml). ASR-free FSMN VAD + CAM++
# speaker embeddings + clustering, no transcription step.
SPEAKER3D_CLUSTERING_URL=http://localhost:9021
SPEAKER3D_CLUSTERING_TIMEOUT_SEC=1800
# Health-wait budget after `docker start`; first start downloads checkpoints.
SPEAKER3D_CLUSTERING_COLD_START_TIMEOUT_SEC=1800

# --- DiariZen (custom container; no turnkey NIM ships this) ---
# Started separately via ./deploy/diarizen/diarizen_up.sh
# (docker-compose.diarizen.yml). WavLM-Large + Conformer local end-to-end
# diarization followed by global clustering. Pretrained weights are
# CC BY-NC 4.0 (non-commercial/research use only).
DIARIZEN_URL=http://localhost:9022
DIARIZEN_TIMEOUT_SEC=1800

# --- VibeVoice-ASR (custom container; no turnkey NIM ships this) ---
# Started separately via ./deploy/vibevoice/vibevoice_up.sh
# (docker-compose.vibevoice.yml). Microsoft's 8B decoder-only model doing ASR
# + speaker diarization + timestamping in a single autoregressive pass. MIT,
# ungated -- no token needed. Served through vLLM (Microsoft's official
# recipe, see deploy/vibevoice/Dockerfile), which decodes well under
# realtime; the wide timeout below is headroom for a cold model or an
# unusually long meeting, not the expected steady-state time. Applies to
# both paths below.
VIBEVOICE_URL=http://localhost:9023
VIBEVOICE_TIMEOUT_SEC=5400
# Cold-start budget for the local container (health-ready wait after
# `docker start`) -- separate from the inference timeout.
VIBEVOICE_COLD_START_TIMEOUT_SEC=600
# Optional remote inference proxy (OpenAI-style chat-completions URL). When
# set, the runner calls it instead of the local container, and vibevoice is
# excluded from the GPU residency cap entirely (no local container, no GPU
# slot). Leave unset to run locally.
# VIBEVOICE_BASEURL=
# VIBEVOICE_API_KEY=
# Leave true unless the proxy sits behind a cert this host doesn't trust
# (internal CA / self-signed).
VIBEVOICE_SSL_VERIFY=true

# --- MOSS-Transcribe-Diarize (stock vLLM image; no custom container) ---
# Started separately via ./deploy/moss-transcribe/moss_transcribe_up.sh
# (docker-compose.moss-transcribe.yml). OpenMOSS's 0.9B end-to-end model doing
# ASR + speaker diarization + timestamping in a single autoregressive pass over
# up to ~90 minutes of audio. Apache-2.0, ungated -- no token needed. Needs no
# Dockerfile: MOSS is registered in vLLM upstream, so the stock
# vllm/vllm-openai image serves it as-is.
MOSS_TRANSCRIBE_URL=http://localhost:9024
# As wide as vibevoice's, and for the same reason: being a small model does not
# make it quick on long audio. Decode is autoregressive over the whole
# transcript, so cost tracks output length, not parameter count. Measured here:
# ~32 tokens/s, so a 32-minute file (~24k tokens) takes ~13 minutes and MOSS's
# ~90-minute ceiling takes ~35. A 30-second clip's apparent speed is prefill,
# and does not extrapolate.
MOSS_TRANSCRIBE_TIMEOUT_SEC=5400
# Cold-start budget for the container (health-ready wait after `docker start`)
# -- separate from the inference timeout. Only ~2GB of weights, but vLLM's
# engine start dominates, so this matches vibevoice rather than scaling down.
MOSS_TRANSCRIBE_COLD_START_TIMEOUT_SEC=600

# --- GPU container lifecycle supervisor (DGX Spark residency cap) ---
# Hard cap on how many of the local-lane model containers above may be
# GPU-resident (started) at once. A request for a model beyond this cap
# waits (re-enqueued) instead of proceeding or erroring. DGX Spark has
# ~120GB unified memory and no MIG/MPS isolation; running all of them at
# once caused OOM kills of unrelated infra containers -- start conservative
# and raise only after confirming headroom.
MAX_RESIDENT_MODELS=2
# How long a model may sit idle (zero active/queued jobs) before the
# supervisor daemon stops its container to free the slot. An idle model can
# still be evicted sooner if a competing request needs the slot right away.
IDLE_UNLOAD_TIMEOUT_SEC=600
# Delay before a job denied a GPU slot (cap already full) is re-enqueued to
# try again.
ADMISSION_REQUEUE_DELAY_SEC=10
# Minimum time between retry attempts against a model stuck "unhealthy" --
# prevents a burst of requests from hammering `docker start` on a genuinely
# broken container.
UNHEALTHY_RETRY_BACKOFF_SEC=120
# Supervisor daemon sweep cadence (idle-unload + staleness checks).
SUPERVISOR_SWEEP_INTERVAL_SEC=15
# Grace period passed to `docker stop --time` before Docker SIGKILLs.
CONTAINER_STOP_GRACE_SEC=30
# Added on top of a model's own cold-start budget as a floor for detecting
# a "starting" row stuck past its deadline (covers the daemon itself being
# down when the deadline passed).
SUPERVISOR_STALE_GRACE_SEC=60

# --- Live-speech transcription (the Live Speech panel) ---
# Two ASR engines produce the word-level transcript; the mode is chosen PER RUN
# from the panel's online/offline toggle, not by a setting here:
#   online  -> TryHamsa STT over WSS. Audio LEAVES this host.
#   offline -> the local cohere-transcribe container. Audio stays on-host.
# The alignment stage below is shared by both modes. The engine actually used
# is recorded per recording, so a later run in the other mode never relabels an
# existing transcript. A mode is only offered when its credentials/endpoint
# below are set; fill in whichever mode(s) this host should support.

# --- TryHamsa STT (online mode) ---
# Either name works; HAMSA_STT_URL wins when both are set.
HAMSA_STT_WS_URL=
HAMSA_STT_KEY=
# Optional Bearer token (ADEO deployments).
HAMSA_STT_BEARER_TOKEN=
# Per-service TLS switch, like VIBEVOICE_SSL_VERIFY. Set false only if the
# endpoint sits behind a cert this host does not trust. Note this is NOT the
# bare SSL_VERIFY some clients read -- that name is not used by this platform.
HAMSA_STT_SSL_VERIFY=true
HAMSA_STT_SAMPLE_RATE=16000
# Seconds to wait between 100ms audio chunks. This is a PACE, not a timeout:
# the server's VAD segments the stream as it arrives, so ASR wall-clock is
# ~half the recording's duration regardless of how fast the model is. 0.05 is
# the value verified against this deployment; lowering it may degrade
# segmentation.
HAMSA_STT_CHUNK_SLEEP_SEC=0.05
# Silence on the socket, after all audio is sent, that marks the transcript
# complete (Hamsa gives no explicit end-of-stream signal).
HAMSA_STT_IDLE_TIMEOUT_SEC=5.0
# Hard ceiling on one streaming session. Must exceed ~0.5x the longest
# recording: a 2-hour file streams for ~1 hour.
HAMSA_STT_SESSION_TIMEOUT_SEC=5400

# --- Cohere Transcribe Arabic (offline mode) ---
# CohereLabs/cohere-transcribe-arabic-07-2026 (2B, Arabic + English) served on
# vLLM. Start it with ./deploy/cohere-transcribe/cohere_transcribe_up.sh --
# the model repo is GATED, so set HF_TOKEN in that folder's own .env first.
# Unlike the diarization containers this one is NOT supervisor-managed: it
# holds no residency slot and nothing starts or stops it automatically.
COHERE_TRANSCRIBE_URL=http://localhost:9025
COHERE_TRANSCRIBE_TIMEOUT_SEC=1800
# Leave this as "ar". EMPTY IS NOT NEUTRAL and is not auto-detect.
#
# This model has no auto-detect at all -- language=auto returns 400 listing the
# 14 codes it accepts. Omitting the field makes it settle on one language from
# the content: mostly-Arabic audio comes back Arabic, but speech that switches
# language WITHIN sentences (what Mixed 50/50 scripts produce) comes back English
# with the Arabic TRANSLATED away, at every duration tested up to 45s. On one real
# bilingual recording that was 97.2% WER with zero Arabic characters, versus 15.3%
# with "ar".
#
# "ar" code-switches rather than forcing everything Arabic, so it is correct for
# English, Arabic and mixed scripts alike. Its one measured cost: on pure-English
# audio it is clean whole-file but leaks Arabic into 6 of 18 short live chunks.
# Full measurement in packages/config/settings.py.
COHERE_TRANSCRIBE_LANGUAGE=ar

# --- CTC forced aligner (word timings; both modes) ---
# Runs in-process in the worker on DIARIZATION_DEVICE. Needs the optional
# model deps: uv sync --extra models
CTC_ALIGNER_LANGUAGE=ara
CTC_ALIGNER_BATCH_SIZE=4

# ---------------------------------------------------------------------------
# Transcript evaluation: Inception-STT via the LiteLLM gateway
# ---------------------------------------------------------------------------
# OpenAI-compatible transcription endpoint. Base URL here does NOT include the
# version prefix; STT_TRANSCRIPTION_PATH carries it.
LITELLM_BASE_URL=https://litellm.example.internal
LITELLM_API_KEY=
STT_TRANSCRIPTION_PATH=/v1/audio/transcriptions
STT_MODEL=inception-stt
# Empty or "auto" both mean auto-detect and send NO language field. A real code
# is a decoder prompt the model obeys over the audio, so forcing "ar" makes
# English audio hallucinate Arabic. Leave blank for mixed ar/en material.
STT_DEFAULT_LANGUAGE=auto
STT_TIMEOUT_SECONDS=120

# How long a piece of audio may be in ONE call. This decides how much transcript
# EXISTS: the gateway silently drops content non-monotonically, and a longer clip
# can return fewer words than a clip it contains. Measured over one fixed 100s
# span (see apps/background_worker/transcription/inception/runner.py):
#   3s -> 219 words | 5s -> 201 | 8s -> 84 | 10s -> 28 | 25s -> 85 | 100s -> 51
# Raising this trades transcript away for fewer requests.
BATCH_SEGMENT_SECONDS=3
BATCH_MAX_CONCURRENCY=4

# TLS for the gateway only. Prefer pointing LITELLM_CA_BUNDLE at the internal CA
# over disabling verification: a bundle wins over the flag, so setting one
# re-enables proper verification without editing VERIFY_SSL.
VERIFY_SSL=true
LITELLM_CA_BUNDLE=

# ---------------------------------------------------------------------------
# TTS synthesis engines (script -> read-aloud audio)
# ---------------------------------------------------------------------------
# Three engines: TryHamsa TTS (streaming, straight to the inference pod),
# TryHamsa TTS (new) (the same vendor through the LiteLLM gateway, single-shot)
# and Inception-TTS (single-shot, via that same gateway as inception-stt).

# --- TryHamsa TTS (streaming) ---
HAMSA_TTS_API_URL=
HAMSA_TTS_KEY=
HAMSA_TTS_BEARER_TOKEN=
# A COMMA LIST, and entry 0 is the default voice. One key, not a default +
# list pair: the pair let the two disagree, and putting the list on the
# singular key posted "Ruba,Sandra" as ONE speaker name -- which this vendor
# accepts with a 200 and then drops the stream on, so it reads as a network
# fault rather than the typo it is. Whitespace and trailing commas are
# stripped, so `Ruba, Sandra,` is fine.
HAMSA_TTS_SPEAKER=Ruba,Sandra
HAMSA_TTS_DIALECT=uae
HAMSA_TTS_LANGUAGE_ID=ar
# ASSUMPTION, not a measurement: this API never states its sample rate
# in-band anywhere in the response. 16000 is chosen because it matches this
# vendor's own declared native STT rate (HAMSA_STT_SAMPLE_RATE) and the exact
# 3200-byte/100ms chunk-size symmetry with Hamsa's STT input convention.
# Correct this if a deployment's actual rate turns out to differ.
HAMSA_TTS_SAMPLE_RATE=16000
# Per-service TLS switch, like HAMSA_STT_SSL_VERIFY. NOT the bare SSL_VERIFY
# below, which is scoped to the LiteLLM gateway only.
HAMSA_TTS_SSL_VERIFY=true
# Must exceed the longest allowed script's synthesis time.
HAMSA_TTS_TIMEOUT_SEC=120

# --- TryHamsa TTS (new) — the same vendor via the LiteLLM gateway ---
# A THIRD engine, not a replacement for HAMSA_TTS_* above. It reuses
# LITELLM_BASE_URL / LITELLM_API_KEY / TTS_SPEECH_PATH, so on a host that
# already runs inception-stt there is nothing to set here.
#
# Reaching this model is about WHICH KEY is in LITELLM_API_KEY, not the id.
# Probed 2026-09-09: one key answered 403 `team not allowed to access model`
# here and listed 10 models; a second key lists 14 including this one and is a
# strict superset. `hamsa-tts` is the older deployment and still resolves, but
# the cloned voices below exist ONLY on `hamsa-tts-new` -- so a 403, or a wave
# of voice 500s, means the credential regressed rather than the model moving.
HAMSA_TTS_NEW_MODEL=hamsa-tts-new
# A COMMA LIST, entry 0 is the default. All 113 bundled speakers ship as the
# code default (every one swept against the live gateway on 2026-09-09), so
# this key stays COMMENTED OUT unless you want a shorter dropdown. Setting it
# empty is not the same as omitting it: an empty value overrides the 113-name
# default with a blank voice, which the gateway answers with a 500. Zeina
# leads because entry 0 is what gets posted when no voice is chosen.
# HAMSA_TTS_NEW_VOICE=Zeina,Amir,Layla
# The vendor's CLONED customer voices, badged NEW in the picker. A SEPARATE
# list from the built-ins so the badge and the dropdown come from one source,
# and so turning the clones off is this one line.
#
# PROBED 2026-09-09: all 12 return real WAV on hamsa-tts-new, as do all 113
# built-ins -- 125/125 green in 31s. They live ONLY on that model: on
# `hamsa-tts` every clone answers 500 while built-ins on the same call
# succeed. So a clone failing points at HAMSA_TTS_NEW_MODEL or the key, never
# at the name (every casing of `adeo_mariam` 500s on the wrong model, and bare
# `mariam` resolves to the built-in of that name instead).
#
# They can still vanish: the vendor's guide says clone reference audio lives in
# the pod's EPHEMERAL /tmp, so a pod restart de-registers them and the clone
# flow must be re-run. `RUN_LIVE_TESTS=1 uv run pytest -m live -k cloned`
# reports whether they resolve; set this EMPTY to stop offering them.
#
# Keep the `adeo_` prefix: 8 of the 12 collide by name with a bundled speaker
# (Mariam, Reem, Leo, Emma, Lily, Claire, Henry, Mia), and two identical rows
# in one dropdown make the pick, the stored clip's key and the scorecard's
# voice column ambiguous.
HAMSA_TTS_NEW_CLONED_VOICE=adeo_mariam,adeo_omar,adeo_karim,adeo_lara,adeo_reem,adeo_faisal,adeo_leo,adeo_emma,adeo_lily,adeo_claire,adeo_henry,adeo_mia
# Measured: 36.7s for 3144 chars (RTF ~0.22), so a full TTS_MAX_INPUT_CHARS
# script lands near 47s. 180s leaves headroom without hanging on a dead
# gateway.
HAMSA_TTS_NEW_TIMEOUT_SEC=180
# No response-format setting: the gateway IGNORES the field and returns
# RIFF/WAVE whatever is asked for (probed with mp3, got real WAV back).

# --- Inception-TTS (via the LiteLLM gateway; single-shot) ---
TTS_SPEECH_PATH=/v1/audio/speech
INCEPTION_TTS_MODEL=inception-tts
# A COMMA LIST, entry 0 is the default. Same shape as HAMSA_TTS_SPEAKER.
# Neither gateway exposes a list-voices endpoint, so the dropdown shows
# exactly what is written here and nothing is discovered at runtime.
INCEPTION_TTS_VOICE=alloy
# Confirmed by ffprobe against the real gateway: genuinely honored (real
# RIFF/WAVE, pcm_s16le, mono, 24000Hz) despite the gateway's Content-Type
# header always claiming audio/mpeg. Never trust that header.
INCEPTION_TTS_RESPONSE_FORMAT=wav
# Must exceed the longest allowed script's synthesis time -- this engine has
# no meaningful streaming (whole body buffers before any bytes arrive).
INCEPTION_TTS_TIMEOUT_SEC=180
# 422 guard so a runaway script fails at the request, not a gateway timeout.
TTS_MAX_INPUT_CHARS=4000

# --- Voice cloning (the Clone sub-mode) ---------------------------------
# Registers a new speaker on the SAME TryHamsa pod hamsa-tts synthesizes
# through, from one reference clip. Not a fourth TTS engine: cloning renders no
# audio, it produces a speaker name that HAMSA_TTS_SPEAKER-style synthesis then
# uses. It reuses HAMSA_TTS_KEY / HAMSA_TTS_BEARER_TOKEN / HAMSA_TTS_SSL_VERIFY.
#
# PATHS COME FROM THE POD'S OWN /openapi.json, probed 2026-09-09, NOT from the
# vendor's written guide -- the two disagree. The guide documents
# /v1/voice-clone, /v1/voices and /v1/speech; the pod serves /tts/voice_clone,
# /tts/load_voice_cloning and /tts/stream. The guide's GET-able voice list does
# not exist at all: every unknown path answers 405 from a catch-all
# OPTIONS /{path} handler, which makes a missing route look like a present one.
#
# Full URLs, not a base plus paths, matching ADEO_QWEN3_ASR_URL and friends.
HAMSA_VOICE_CLONE_URL=
HAMSA_LOAD_VOICE_URL=
# Extraction runs a model over the whole reference clip, so it is slower than
# synthesis and gets its own budget rather than borrowing HAMSA_TTS_TIMEOUT_SEC.
HAMSA_VOICE_CLONE_TIMEOUT_SEC=300
# A COMMA LIST, entry 0 is the default. Same shape as HAMSA_TTS_SPEAKER. The pod
# defaults `dialect` to "msa" in its own schema, so that stays first. Nothing
# discovers these; the dropdown is exactly this value.
VOICE_CLONE_DIALECTS=msa,uae,egy,ksa,jor
# Bounds the transcript that gets ALIGNED against the audio, which is a
# different thing from TTS_MAX_INPUT_CHARS bounding what gets synthesized.
VOICE_CLONE_MAX_PROMPT_CHARS=4000
# THE POD DOWNLOADS THE REFERENCE CLIP ITSELF, from wherever the pod runs -- it
# cannot reach 127.0.0.1 on this box. Set this to a base URL for THIS API that
# the pod can actually resolve and uploaded clips become clonable; leave it
# unset and the UI offers only the paste-a-public-URL path instead of a control
# that would always fail. Deliberately not defaulted: a guessed hostname
# produces a URL that resolves nowhere and comes back as an opaque 500.
VOICE_CLONE_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Script generation (the read-aloud reference text)
# ---------------------------------------------------------------------------
# A separate OpenAI-compatible chat-completions gateway, with NO cross-default
# to the STT one above: a silent fallback between two gateways is how the wrong
# model gets called. Base URL is expected to already carry its version prefix
# (e.g. ".../api/v1"), which is why LLM_CHAT_PATH has none.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CHAT_PATH=/chat/completions
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SEC=180
LLM_TEMPERATURE=1.0
# Read-aloud pace with natural pauses, used only to size the prompt. The word
# count reported back is always MEASURED from the generated text.
SCRIPT_WORDS_PER_MINUTE=70
# The script controls' options, served to the browser by GET /config so none of
# them is a literal in the frontend.
SCRIPT_LENGTH_OPTIONS_MIN=1,3,5,10
SCRIPT_LANGUAGE_MIXES=ar,mixed-50-50,en
SCRIPT_HARD_CASES=proper-nouns,numbers-dates,emirati-dialect,fast-speech

# ---------------------------------------------------------------------------
# Live read-aloud sessions
# ---------------------------------------------------------------------------
LIVE_RECORD_SAMPLE_RATE=16000
# Chunk interval for engines that cannot stream: a default plus the bounds of the
# UI control. The ONLY knob on chunking — there is deliberately no silence
# threshold or lookback, so cut points are never chosen by inspecting the audio.
LIVE_CHUNK_DEFAULT_SEC=3
LIVE_CHUNK_MIN_SEC=1
LIVE_CHUNK_MAX_SEC=10
# How long an in-progress session's text and latencies survive in Redis.
LIVE_SESSION_TTL_SEC=7200
# Deadline for a streaming engine's WebSocket to open. A dropped upgrade (e.g. a
# dev proxy without `ws: true`) neither opens nor errors, so a caller without a
# deadline waits forever and the recorder looks dead rather than broken.
LIVE_SOCKET_OPEN_TIMEOUT_SEC=10
# An even language split is requested but not reliably obeyed: measured over six
# runs at identical settings the Arabic share came back 42/92/94% at one minute
# and 78/78/46% at three. A script whose MEASURED split falls outside the band is
# regenerated. Tolerance is a half-width around 50%, so 0.15 accepts 35-65%
# Arabic. Attempts is a total, not retries; 1 disables the check.
SCRIPT_MIX_TOLERANCE=0.15
SCRIPT_MIX_MAX_ATTEMPTS=3
# Samples per microphone callback. A LATENCY setting: at 16 kHz a 4096-sample
# block is 256ms, so PCM reached the streaming engine in bursts of ~2.6 of its
# 100ms frames and a chunk was emitted up to 256ms after its audio existed. 1024
# is 64ms. Power of two between 256 and 16384 (Web Audio's constraint).
LIVE_RECORD_BLOCK_SAMPLES=1024

# Keepalive for the STT gateway connection pool. Also a latency setting: httpx's
# module-level post() opens a new TCP+TLS connection per call, measured at 73ms of
# a 107ms round trip against this gateway — 68% of a figure the scorecard
# attributes to the engine. Must exceed LIVE_CHUNK_MAX_SEC or the connection
# expires between chunks and every call re-handshakes.
STT_KEEPALIVE_EXPIRY_SEC=30
STT_MAX_CONNECTIONS=16

# --- Speechmatics (hosted batch job API: submit, poll, fetch) ---
# The key is REGION-SCOPED: a key valid on asr.api 401s on eu2.asr, so changing
# this URL to another region is an auth change, not a latency tweak.
SPEECHMATICS_API_KEY=
SPEECHMATICS_URL=https://asr.api.speechmatics.com/v2
# "ar_en" selects Speechmatics' BILINGUAL Arabic+English pack -- a real
# code-switching model, not a pinned language. The API reports the pack it ran as
# "Arabic and English", and it keeps Arabic in Arabic script and English in Latin
# inside one transcript.
#
# Do NOT set this to "auto". Language identification is a DIFFERENT feature: it
# detects one single language and transcribes the whole file in it. Measured on
# the same 61s code-switched clip:
#     ar_en -> WER 0.589, 119 deletions, English kept
#     auto  -> WER 0.729, 154 deletions, English dropped or transliterated
SPEECHMATICS_LANGUAGE=ar_en
SPEECHMATICS_OPERATING_POINT=enhanced
SPEECHMATICS_POLL_INTERVAL_SEC=3
SPEECHMATICS_TIMEOUT_SEC=1800

# --- Speechmatics REAL-TIME (WebSocket streaming, live surface) ---
# The live-transport half of the Speechmatics engine. Same API key as above,
# DIFFERENT product (`<region>.rt.speechmatics.com`, no `.api.` in the host
# scheme) and a WebSocket rather than the batch job API. Feeds the read-aloud
# surface's stream transport via a short-lived JWT minted from the API key.
# See apps/background_worker/transcription/speechmatics/live_relay.py for
# the wire protocol (StartRecognition, binary PCM frames with AudioAdded
# acks, AddPartialTranscript / AddTranscript, EndOfStream / EndOfTranscript).
SPEECHMATICS_RT_URL=wss://eu.rt.speechmatics.com/v2
SPEECHMATICS_RT_MINT_URL=https://mp.speechmatics.com/v1/api_keys
SPEECHMATICS_RT_TEMP_KEY_TTL_SEC=300
SPEECHMATICS_RT_ENABLE_PARTIALS=true
SPEECHMATICS_RT_MAX_DELAY=2
SPEECHMATICS_RT_IDLE_TIMEOUT_SEC=30
SPEECHMATICS_RT_SESSION_TIMEOUT_SEC=3600

# --- ElevenLabs Scribe (hosted, one whole-file POST) ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_URL=https://api.elevenlabs.io/v1/speech-to-text
# Validated server-side: a bad id 400s naming the valid models, so a typo fails
# loudly rather than silently falling back to an older model.
ELEVENLABS_STT_MODEL=scribe_v2
# "auto" or empty OMITS language_code, which is what makes this engine detect.
# Measured: omitted -> detected "ara" at 0.968 confidence AND kept the English in
# Latin script (WER 0.564, best of every engine probed). Forcing a single code
# can only take that away.
ELEVENLABS_STT_LANGUAGE=auto
ELEVENLABS_STT_TIMEOUT_SEC=600

# --- ElevenLabs Scribe v2 REALTIME (WebSocket streaming) ---
# The live-transport half of the ElevenLabs engine. Same xi-api-key as above,
# DIFFERENT model id (`scribe_v2_realtime`, not `scribe_v2`) and a WebSocket
# endpoint rather than an HTTP POST. Feeds the read-aloud surface's stream
# transport. See apps/background_worker/transcription/elevenlabs/live_relay.py
# for the wire protocol (base64-inside-JSON `input_audio_chunk` messages).
ELEVENLABS_STT_REALTIME_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
# manual|vad. Manual means WE commit explicitly at stop; vad lets Scribe
# auto-commit on server-side silence detection. Manual is the default because
# the scorecard's committed segments are what get scored and a heuristic-driven
# cadence would move the boundary this comparison is meant to hold fixed.
ELEVENLABS_STT_REALTIME_COMMIT_STRATEGY=manual
ELEVENLABS_STT_REALTIME_IDLE_TIMEOUT_SEC=15
ELEVENLABS_STT_REALTIME_SESSION_TIMEOUT_SEC=3600

# --- ADEO Qwen3-ASR (per-model proxy: own URL AND own bearer token) ---
# Not the LiteLLM gateway; that gateway's /v1/models lists no ASR model beyond
# hamsa-stt and inception-stt.
ADEO_QWEN3_ASR_URL=
ADEO_QWEN3_ASR_API_KEY=
ADEO_QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ADEO_QWEN3_ASR_TIMEOUT_SEC=600
# There is deliberately NO language variable for this engine. vLLM validates
# `language` and the model then ignores it: omitted, "ar" and "en" returned
# byte-identical text (same sha256, 821 chars) on the same code-switched clip,
# while "auto" and "ar,en" are rejected 400 against a 57-code list. The field can
# only ever break a request, never change one, so it is never sent. The model
# code-switches natively with it absent.

# --- ADEO Whisper (per-model proxy on the same ADEO host) ---
# UNVERIFIED: this pod answered 504 "Upstream service is unavailable" on every
# attempt over ~2 minutes on 2026-09-01, including its own /v1/models, so its
# response shape was never observed. Implemented against the OpenAI transcription
# contract the sibling Qwen3 pod above is proven to speak. Probe it once it is up.
ADEO_WHISPER_URL=
ADEO_WHISPER_API_KEY=
# Empty omits `model`, matching this pod's working curl.
ADEO_WHISPER_MODEL=
# "auto" or empty omits `language` so Whisper auto-detects.
ADEO_WHISPER_LANGUAGE=auto
ADEO_WHISPER_TIMEOUT_SEC=600

# MOSS-Transcribe-Diarize and VibeVoice-ASR are ALSO scored as STT engines now,
# and add NO settings of their own: each reuses the MOSS_TRANSCRIBE_URL /
# VIBEVOICE_URL and timeouts already defined for the diarization side above.
# Neither accepts a language parameter -- MOSS validates-then-ignores it exactly
# like Qwen3, and VibeVoice is a chat-completions call with no such field.

# --- Pre-start the transcript surface's GPU containers ---
# true  -> the supervisor starts moss-transcribe and vibevoice at `honcho start`,
#          waits for each to report healthy, and PINS them so idle-unload never
#          stops them. All nine STT engines are then available for a comparison.
# false -> default. Those two engines report "not configured" whenever their
#          container is down, and nothing on the transcript path can start it.
#
# The pin is the load-bearing half. Raising IDLE_UNLOAD_TIMEOUT_SEC does NOT
# achieve this: idle is measured from `last_job_finished_at`, which for these two
# models is weeks old (795h and 697h as measured on 2026-09-01), so they are
# unloaded on the first sweep at any timeout short of ~2.9 million seconds.
#
# This DELIBERATELY OVERRIDES GPU residency policy. Pinned containers ignore
# MAX_RESIDENT_MODELS and ignore vibevoice's `requires_exclusive_gpu`. On this
# GB10 both were observed up, healthy and transcribing at the same time, so that
# flag is conservative here; on a smaller GPU vibevoice would fail to become
# healthy instead of failing loudly. A diarization job for another model may also
# find no GPU room. Leave it false on a shared host.
STT_PRESTART_CONTAINERS=false

# --- Inception-STT batch behaviour ---
# true = one whole-file call, which gives inception-stt and cohere-transcribe the
# SAME input in batch so their rates are comparable. It costs content: this
# gateway silently truncates a single call, recovering 542 of 1932 reference
# words (28%, aggregate WER 0.782) across 9 recordings, against 0.362 for 5s
# splitting. The cause is an OUTPUT cap, not a time limit -- a 130s recording
# returned byte-identical text at 50, 60, 75, 90, 110 and 130s of input.
INCEPTION_BATCH_WHOLE_FILE=true
# Only read when the flag above is false. 5 is the best measured value; the loss
# is non-monotonic per recording, so tune from an aggregate, never one clip.
BATCH_SEGMENT_SECONDS=3

# --- Live chunk interval ---
# NOT per engine: one recorder cuts one chunk stream and the same bytes go to
# every chunked engine, which is what keeps the live comparison apple to apple.
# hamsa is unaffected -- it streams and takes no chunks.
# LIVE_CHUNK_MAX_SEC is the UI bound and the route's 422 guard, so it must be
# >= LIVE_CHUNK_DEFAULT_SEC or every session is rejected.
LIVE_CHUNK_DEFAULT_SEC=3
LIVE_CHUNK_MAX_SEC=10
