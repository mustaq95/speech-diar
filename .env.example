# Copy to .env and adjust. Every runtime setting lives here and is read
# ONLY through packages/config/settings.py — moving between dev, staging,
# production, or DGX Spark means editing this file, not the code.

# --- Database (Postgres) ---
DATABASE_URL=postgresql+psycopg://diarization:diarization@localhost:5432/diarization

# --- Queue (Redis / RQ) ---
REDIS_URL=redis://localhost:6379/0
# Number of worker processes ./scripts/run_workers.sh starts, so that many
# models can run at the same time instead of queueing behind one another
# (DGX: raise this further).
WORKER_CONCURRENCY=3

# --- Primary storage lane: MinIO / S3 (used by local diarization models) ---
# Matches docker-compose.yml defaults locally; point at real S3/managed
# storage in production by changing these three.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=diarization-audio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Azure Speech (real-time + batch diarization) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Optional custom endpoint (AI Foundry); batch uses this when set, else
# https://<AZURE_SPEECH_REGION>.api.cognitive.microsoft.com
AZURE_SPEECH_ENDPOINT=
# Default recognition locale for both the real-time and batch engines.
LOCALE=en-US
AZURE_REALTIME_TRANSCRIBE_TIMEOUT_SEC=600
AZURE_BATCH_POLL_INTERVAL_SEC=10
AZURE_BATCH_JOB_TIMEOUT_SEC=1800
AZURE_BATCH_TIME_TO_LIVE=PT4H
AZURE_BATCH_MAX_SPEAKERS=8

# --- Azure lane storage: Blob (ONLY touched when the Azure model is toggled
# on; audio for that lane never touches MinIO) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=diarization-audio
AZURE_STORAGE_SAS_READ_EXPIRY_HOURS=48

# --- API ---
API_PORT=8010
# Comma-separated list of origins allowed to call the API (the Vite dev
# server by default).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend runtime config (served via GET /config; changing this needs
# no frontend rebuild) ---
FRONTEND_POLL_INTERVAL_MS=1500

# --- Local diarization models ---
# cpu on a dev machine; cuda on DGX Spark or any CUDA-equipped worker host.
DIARIZATION_DEVICE=cpu
