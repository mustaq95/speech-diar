# Copy to .env and adjust. Every runtime setting lives here and is read
# ONLY through packages/config/settings.py — moving between dev, staging,
# production, or DGX Spark means editing this file, not the code.

# --- Database (Postgres) ---
DATABASE_URL=postgresql+psycopg://postgres:pg123456@localhost:5432/diarization

# --- Queue (Redis / RQ) ---
REDIS_URL=redis://localhost:6379/0
# Number of worker processes ./scripts/run_workers.sh starts, so that many
# models can run at the same time instead of queueing behind one another
# (DGX: raise this further).
WORKER_CONCURRENCY=3
# Ceiling on how long a single model's job may run before RQ kills it. Must
# stay >= the largest per-model timeout below (AZURE_BATCH_JOB_TIMEOUT_SEC /
# NEMO_CLUSTERING_TIMEOUT_SEC at 1800s) or those never get a chance to
# fire -- AND, since the GPU supervisor (see below) can make a job wait out
# a container cold-start before its own inference timeout starts counting,
# it must stay >= the largest (cold-start + inference) SUM across managed
# models. Worst case today: vibevoice's 600s cold-start + 5400s inference
# = 6000s floor, padded here for margin.
QUEUE_JOB_TIMEOUT_SEC=6600

# --- Primary storage lane: MinIO / S3 (used by local diarization models) ---
# Matches docker-compose.yml defaults locally; point at real S3/managed
# storage in production by changing these three.
# Port 9010, not 9000: on DGX Spark hosts running the Parakeet NIM containers,
# host port 9000 is owned by parakeet-nim-str's HTTP API (see NIM_* below).
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=diarization-audio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Azure Speech (real-time + batch diarization) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Optional custom endpoint (AI Foundry); batch uses this when set, else
# https://<AZURE_SPEECH_REGION>.api.cognitive.microsoft.com
AZURE_SPEECH_ENDPOINT=
# Default recognition locale for both the real-time and batch engines.
LOCALE=en-US
AZURE_REALTIME_TRANSCRIBE_TIMEOUT_SEC=1800
AZURE_BATCH_POLL_INTERVAL_SEC=10
AZURE_BATCH_JOB_TIMEOUT_SEC=1800
AZURE_BATCH_TIME_TO_LIVE=PT4H
AZURE_BATCH_MAX_SPEAKERS=8

# --- Azure lane storage: Blob (ONLY touched when the Azure model is toggled
# on; audio for that lane never touches MinIO) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=diarization-audio
AZURE_STORAGE_SAS_READ_EXPIRY_HOURS=48

# --- API ---
API_PORT=8010
# Comma-separated list of origins allowed to call the API (the Vite dev
# server by default).
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Frontend runtime config (served via GET /config; changing this needs
# no frontend rebuild) ---
FRONTEND_POLL_INTERVAL_MS=1500

# --- Local diarization models ---
# cpu on a dev machine; cuda on DGX Spark or any CUDA-equipped worker host.
DIARIZATION_DEVICE=cpu
# HuggingFace access token, required to download the gated pyannote community-1
# pipeline, plus speaker-diarization-3.1 and its segmentation-3.0 dependency
# (used by the wespeaker-resnet34 model). Accept the model conditions at
# https://huggingface.co/pyannote/speaker-diarization-community-1,
# https://huggingface.co/pyannote/speaker-diarization-3.1, and
# https://huggingface.co/pyannote/segmentation-3.0 first.
HUGGINGFACE_TOKEN=
# Directory for sherpa-onnx's segmentation.onnx and embedding.onnx model
# files; downloaded here on first use if missing (ungated, no token needed).
SHERPA_MODEL_DIR=~/.cache/sherpa-onnx-diarization

# --- NVIDIA Parakeet-Sortformer NIM (DGX Spark local Triton/Riva containers) ---
# Started separately via ./deploy/parakeet_nim_up.sh (docker-compose.parakeet-nim.yml).
# gRPC endpoints, not the HTTP ones -- diarization speaker tags are only
# exposed on the Riva gRPC API, not the plain /v1/audio/transcriptions route.
NIM_STR_GRPC=localhost:50051
NIM_OFL_GRPC=localhost:50052
# HTTP health-check ports only -- must match deploy/parakeet/parakeet-nim.env's
# PARAKEET_NIM_HTTP_PORT / PARAKEET_NIM_OFL_HTTP_PORT. Change both together if
# 9000/9001 collide with something else already running on the host.
NIM_STR_HEALTH_PORT=9030
NIM_OFL_HEALTH_PORT=9031
NIM_LANGUAGE=multi
NIM_MAX_SPEAKERS=8
NIM_GRPC_TIMEOUT_SEC=1800
# Separate from NIM_GRPC_TIMEOUT_SEC (bounds one ASR call): the GPU
# supervisor's cold-start budget while waiting for /v1/health/ready after a
# `docker start`.
NIM_COLD_START_TIMEOUT_SEC=1800

# --- NeMo Clustering Diarizer (custom container; no turnkey NIM ships this) ---
# Started separately via ./deploy/nemo-clustering/nemo_clustering_up.sh
# (docker-compose.nemo-clustering.yml). Cascaded MarbleNet VAD + TitaNet +
# spectral clustering, for meetings with more speakers than the Sortformer
# NIMs above are tuned for.
NEMO_CLUSTERING_URL=http://localhost:9020
NEMO_CLUSTERING_TIMEOUT_SEC=1800

# --- 3D-Speaker CAM++ Clustering Diarizer (custom container; no turnkey NIM ships this) ---
# Started separately via
# ./deploy/3d-speaker-clustering/3d_speaker_clustering_up.sh
# (docker-compose.3d-speaker-clustering.yml). ASR-free FSMN VAD + CAM++
# speaker embeddings + clustering, no transcription step.
SPEAKER3D_CLUSTERING_URL=http://localhost:9021
SPEAKER3D_CLUSTERING_TIMEOUT_SEC=1800
# Health-wait budget after `docker start`; first start downloads checkpoints.
SPEAKER3D_CLUSTERING_COLD_START_TIMEOUT_SEC=1800

# --- DiariZen (custom container; no turnkey NIM ships this) ---
# Started separately via ./deploy/diarizen/diarizen_up.sh
# (docker-compose.diarizen.yml). WavLM-Large + Conformer local end-to-end
# diarization followed by global clustering. Pretrained weights are
# CC BY-NC 4.0 (non-commercial/research use only).
DIARIZEN_URL=http://localhost:9022
DIARIZEN_TIMEOUT_SEC=1800

# --- VibeVoice-ASR (custom container; no turnkey NIM ships this) ---
# Started separately via ./deploy/vibevoice/vibevoice_up.sh
# (docker-compose.vibevoice.yml). Microsoft's 8B decoder-only model doing ASR
# + speaker diarization + timestamping in a single autoregressive pass. MIT,
# ungated -- no token needed. Served through vLLM (Microsoft's official
# recipe, see deploy/vibevoice/Dockerfile), which decodes well under
# realtime; the wide timeout below is headroom for a cold model or an
# unusually long meeting, not the expected steady-state time. Applies to
# both paths below.
VIBEVOICE_URL=http://localhost:9023
VIBEVOICE_TIMEOUT_SEC=5400
# Cold-start budget for the local container (health-ready wait after
# `docker start`) -- separate from the inference timeout.
VIBEVOICE_COLD_START_TIMEOUT_SEC=600
# Optional remote inference proxy (OpenAI-style chat-completions URL). When
# set, the runner calls it instead of the local container, and vibevoice is
# excluded from the GPU residency cap entirely (no local container, no GPU
# slot). Leave unset to run locally.
# VIBEVOICE_BASEURL=
# VIBEVOICE_API_KEY=
# Leave true unless the proxy sits behind a cert this host doesn't trust
# (internal CA / self-signed).
VIBEVOICE_SSL_VERIFY=true

# --- GPU container lifecycle supervisor (DGX Spark residency cap) ---
# Hard cap on how many of the local-lane model containers above may be
# GPU-resident (started) at once. A request for a model beyond this cap
# waits (re-enqueued) instead of proceeding or erroring. DGX Spark has
# ~120GB unified memory and no MIG/MPS isolation; running all of them at
# once caused OOM kills of unrelated infra containers -- start conservative
# and raise only after confirming headroom.
MAX_RESIDENT_MODELS=2
# How long a model may sit idle (zero active/queued jobs) before the
# supervisor daemon stops its container to free the slot. An idle model can
# still be evicted sooner if a competing request needs the slot right away.
IDLE_UNLOAD_TIMEOUT_SEC=600
# Delay before a job denied a GPU slot (cap already full) is re-enqueued to
# try again.
ADMISSION_REQUEUE_DELAY_SEC=10
# Minimum time between retry attempts against a model stuck "unhealthy" --
# prevents a burst of requests from hammering `docker start` on a genuinely
# broken container.
UNHEALTHY_RETRY_BACKOFF_SEC=120
# Supervisor daemon sweep cadence (idle-unload + staleness checks).
SUPERVISOR_SWEEP_INTERVAL_SEC=15
# Grace period passed to `docker stop --time` before Docker SIGKILLs.
CONTAINER_STOP_GRACE_SEC=30
# Added on top of a model's own cold-start budget as a floor for detecting
# a "starting" row stuck past its deadline (covers the daemon itself being
# down when the deadline passed).
SUPERVISOR_STALE_GRACE_SEC=60
